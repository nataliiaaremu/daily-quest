{
  "name": "daily-quest",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "prerender": "ng run daily-quest:prerender",
    "gzip": "gzipper compress --verbose ./dist/",
    "prod": "ng run daily-quest:prerender && pnpm run gzip",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessCI",
    "audit:ci": "pnpm audit --prod --audit-level=high",
    "build:ci": "ng run daily-quest:prerender"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.5",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/platform-browser-dynamic": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@ant-design/icons-angular": "^22.1.1",
    "@ctrl/tinycolor": "^4.2.2",
    "date-fns": "^4.4.0",
    "ng-zorro-antd": "22.2.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.6",
    "@angular/cli": "~22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@angular/platform-server": "22.2.5",
    "@types/jasmine": "~4.3.6",
    "@types/node": "^18.19.130",
    "@types/uuid": "^9.0.8",
    "concurrently": "^9.2.5",
    "gzipper": "^4.5.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~4.5.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.1.1",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "pnpm": {
    "overrides": {
      "gzipper>uuid": "^11.1.1"
    }
  },
  "packageManager": "pnpm@10.22.0"
}
